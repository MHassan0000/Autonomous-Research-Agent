# Research workflow runtime
RESEARCH_OUTPUT_DIR=.tmp/reports
RESEARCH_MEMORY_DB=.tmp/research_memory/research.db
SEARCH_BACKEND=bing_rss
MAX_CONCURRENCY=4
REQUEST_TIMEOUT_SECONDS=20
MAX_SEARCH_RESULTS=8
MAX_RESEARCH_ITERATIONS=3
USER_AGENT=AutonomousResearchAgent/1.0

# Optional filters
ALLOWED_DOMAINS=
BLOCKED_DOMAINS=
FRESHNESS_DAYS=

# Optional future model backend
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_HTTP_REFERER=
MODEL_TITLE=Autonomous Research Agent

# Optional OpenRouter shortcut
OPENROUTER_API_KEY=
